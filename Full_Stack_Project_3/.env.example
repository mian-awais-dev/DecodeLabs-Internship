# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=products_api_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_MAX=20
DB_TIMEOUT_MS=5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Authentication & API Keys (Static tokens for development/demonstration)
ADMIN_TOKEN=admin-token-secret-123
VIEWER_TOKEN=viewer-token-secret-456
ADMIN_API_KEY=api-key-admin
VIEWER_API_KEY=api-key-viewer
